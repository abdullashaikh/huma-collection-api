# ==============================================================================
# HUMA HIJAB COLLECTION — BACKEND ENVIRONMENT CONFIGURATION (SAMPLE)
# ==============================================================================

NODE_ENV=development
PORT=5000
APP_NAME="Huma Hijab Collection API"
API_PREFIX=/api/v1
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Database (MySQL 8.0 / AWS RDS)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=huma_collection_db
DB_CONNECTION_LIMIT=20
DB_WAIT_FOR_CONNECTIONS=true

# Security & JWT Tokens
JWT_ACCESS_SECRET=huma_secret_access_jwt_production_grade_token_2026
JWT_REFRESH_SECRET=huma_secret_refresh_jwt_production_grade_token_2026
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
COOKIE_SECRET=huma_secure_cookie_signer_key_3948572019

# Razorpay Payment Gateway (Test / Live credentials)
RAZORPAY_KEY_ID=rzp_test_HumaHijab2026
RAZORPAY_KEY_SECRET=HumaTestSecretKey987654321
RAZORPAY_WEBHOOK_SECRET=HumaWebhookSecretSecure999

# AWS S3 Storage & CloudFront CDN
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=AKIA_HUMA_MEDIA_UPLOADER
AWS_SECRET_ACCESS_KEY=mock_aws_secret_access_key_placeholder
AWS_S3_BUCKET=huma-collection-media-prod
CLOUDFRONT_DOMAIN=https://media.humahijabcollection.com

# WhatsApp & Business Defaults
WHATSAPP_SUPPORT_NUMBER=+919876543210
SUPPORT_EMAIL=support@humahijabcollection.com
STORE_NAME="Huma Hijab Collection"
DEFAULT_CURRENCY=INR
